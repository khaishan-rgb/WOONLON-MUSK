# Copy to gateway.env (same folder as moomoo_gateway.py) on YOUR computer. Never upload gateway.env to GitHub.
SENTRY_URL=https://your-app.onrender.com
GATEWAY_TOKEN=paste-the-GATEWAY_TOKEN-value-from-Render-here
OPEND_HOST=127.0.0.1
OPEND_PORT=11111
# moomoo Singapore = FUTUSG, moomoo US = FUTUINC
MOOMOO_SECURITY_FIRM=FUTUSG
# Leave the next two as they are unless you really want SENTRY to send REAL-money orders you confirm.
MOOMOO_ALLOW_REAL_ORDERS=0
MOOMOO_TRADE_PWD=
